# AvestoAI Backend Environment Configuration Template
# Copy this file to .env and fill in your actual values

# =============================================================================
# ENVIRONMENT CONFIGURATION
# =============================================================================
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
PORT=8080
HOST=0.0.0.0

# CORS and Security
ALLOWED_ORIGINS=["http://localhost:3000", "https://your-frontend-domain.com"]
ALLOWED_HOSTS=["localhost", "127.0.0.1", "your-backend-domain.com"]

# =============================================================================
# GOOGLE CLOUD PLATFORM CONFIGURATION
# =============================================================================
# Your GCP Project ID
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Vertex AI Configuration
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_MODEL=gemini-pro

# Firestore Configuration
FIRESTORE_DATABASE=(default)

# Google Cloud Authentication
# Option 1: Service Account Key File (for local development)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account-key.json

# Option 2: For GCP Cloud Run (leave empty to use default service account)
# GOOGLE_APPLICATION_CREDENTIALS=

# =============================================================================
# FI MCP SERVICE CONFIGURATION
# =============================================================================
FI_MCP_BASE_URL=https://fi-mcp-dev-172306289913.asia-south1.run.app
FI_MCP_TIMEOUT=30

# =============================================================================
# MONITORING AND OBSERVABILITY
# =============================================================================
# OpenTelemetry Configuration
OTEL_SERVICE_NAME=avestoai-backend
OTEL_SERVICE_VERSION=1.0.0
OTEL_RESOURCE_ATTRIBUTES=service.name=avestoai-backend,service.version=1.0.0

# Traceloop Configuration (optional)
TRACELOOP_API_KEY=your-traceloop-api-key

# PostHog Configuration (optional)
POSTHOG_API_KEY=your-posthog-api-key
POSTHOG_HOST=https://app.posthog.com

# =============================================================================
# RATE LIMITING AND PERFORMANCE
# =============================================================================
RATE_LIMIT_CALLS=100
RATE_LIMIT_PERIOD=60

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# JWT Secret (generate a secure random string)
JWT_SECRET=your-super-secure-jwt-secret-key-here

# API Keys (if needed)
API_KEY_HEADER=X-API-Key
API_KEYS=["your-api-key-1", "your-api-key-2"]

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================
# Set to true for development features
ENABLE_DOCS=true
ENABLE_METRICS_ENDPOINT=true

# =============================================================================
# CLOUD RUN SPECIFIC CONFIGURATION
# =============================================================================
# These are automatically set by Cloud Run, but you can override for testing
# CLOUD_RUN_SERVICE=avestoai-backend
# CLOUD_RUN_REVISION=avestoai-backend-00001-abc
# K_SERVICE=avestoai-backend
# K_REVISION=avestoai-backend-00001-abc
# K_CONFIGURATION=avestoai-backend

# =============================================================================
# OPTIONAL SERVICES
# =============================================================================
# Redis Configuration (if using caching)
# REDIS_URL=redis://localhost:6379

# Database Configuration (if using additional databases)
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_ON_DEVICE_AI=false
ENABLE_REAL_TIME_STREAMING=true
ENABLE_ADVANCED_ANALYTICS=true
